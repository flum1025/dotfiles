#!/usr/bin/env bash
# taskenv: タスク単位で、指定したリポジトリセットの git worktree を
#   <project>/__tasks/<task>/<repo>
# に一括作成し、そのタスクディレクトリを tmux の新規ウィンドウで開く。
# 配置先は worktrunk の worktree-path テンプレートが決める。
# リポジトリセットはプロジェクトディレクトリ直下の .tasksets.yaml で定義する。
#
# あわせて、タスクごとに「ポートスロット」を1つ払い出し、
#   <project>/__tasks/<task>/mise.toml
# に ANDL_PORT_<SERVICE> として書き出す(mise は親ディレクトリの設定も読むため、
# 配下の全リポに効く)。各リポの mise.local.toml がこれを参照してポートを切り替えるので、
# 複数タスクのサーバーを同時に起動できる。ポート定義は .tasksets.yaml の ports セクション。
#
#   usage: taskenv [--base <ref>] [--slot <n>] [--prompt [text]] <set> <task>          # .tasksets.yaml の sets.<set> を使う
#          taskenv [--base <ref>] [--slot <n>] [--prompt [text]] --repos r1,r2 <task>  # セットを使わずリポを直接指定
#          taskenv --rm <task>                                       # タスクの worktree を全リポから撤去
#          taskenv --ports [<task>]                                  # 割り当て済みポートを表示
#          taskenv [--slot <n>] --assign <task>                      # 既存タスクにポートだけ後付けする
#   --base <ref>:    新ブランチの派生元。既定は各リポの origin default branch(= origin/main)
#   --slot <n>:      ポートスロットを明示指定(既定: 空いている最小の番号)
#   --prompt [text]: 起動する claude に渡す初期プロンプト。text 指定で直接(例 --prompt "hello")、
#                    text 省略(--prompt を末尾に置く)で $EDITOR による対話入力(複数行可)
set -euo pipefail

usage() {
  echo "usage: taskenv [--base <ref>] [--slot <n>] [--prompt [text]] <set> <task>" >&2
  echo "       taskenv [--base <ref>] [--slot <n>] [--prompt [text]] --repos r1,r2 <task>" >&2
  echo "       taskenv --rm <task>" >&2
  echo "       taskenv --ports [<task>]" >&2
  echo "       taskenv [--slot <n>] --assign <task>" >&2
  echo "  --base <ref>:    派生元(既定: origin の default branch = origin/main)" >&2
  echo "  --slot <n>:      ポートスロット(既定: 空いている最小の番号)" >&2
  echo "  --prompt [text]: claude 初期プロンプト。text 省略(--prompt を末尾)で \$EDITOR 対話入力(複数行可)" >&2
  exit 1
}

# --base <ref> / --slot <n> を任意位置から抽出(残りは位置引数として後段で処理)
base_override=""
slot_override=""
prompt_val=""
prompt_mode=""   # "" | value | interactive
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "taskenv: --base にはブランチ/ref を指定してください" >&2; usage; }
      base_override="$2"; shift 2 ;;
    --slot)
      [ $# -ge 2 ] || { echo "taskenv: --slot には番号を指定してください" >&2; usage; }
      slot_override="$2"; shift 2 ;;
    --prompt)
      # 次トークンがあり且つ --* でなければ直接値。無ければ(末尾 or 次が --*)対話入力
      if [ $# -ge 2 ] && [ "${2#--}" = "$2" ]; then
        prompt_val="$2"; prompt_mode="value"; shift 2
      else
        prompt_mode="interactive"; shift
      fi ;;
    *) positional+=("$1"); shift ;;
  esac
done
set -- ${positional[@]+"${positional[@]}"}

# cwd から上に辿って .tasksets.yaml を持つプロジェクトディレクトリを探す
project=""
dir="$PWD"
while [ "$dir" != "/" ]; do
  if [ -f "$dir/.tasksets.yaml" ]; then project="$dir"; break; fi
  dir="$(dirname "$dir")"
done
[ -n "$project" ] || { echo "taskenv: .tasksets.yaml が見つかりません(プロジェクトディレクトリ内で実行してください)" >&2; exit 1; }
tasksets="$project/.tasksets.yaml"

# ---- ポートスロット ----------------------------------------------------------

port_stride="$(yq -r '.ports.stride // 100' "$tasksets")"
port_slots="$(yq -r '.ports.slots // 8' "$tasksets")"

# ports.services が空なら、ポート機能なし(mise.toml も作らない)で従来どおり動く
has_ports() { [ "$(yq -r '.ports.services // {} | length' "$tasksets")" -gt 0 ]; }

# サービス名 → 環境変数名の末尾(work-admin → WORK_ADMIN)
port_var_suffix() { printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'; }

# タスクの mise.toml から割り当て済みスロット番号を読む
slot_in_file() {
  [ -f "$1" ] || return 0
  grep -m1 -E '^ANDL_TASK_SLOT *= *"[0-9]+"' "$1" 2>/dev/null | tr -dc '0-9' || true
}

# --slot で明示指定された番号を検証する。
# 自動払い出し(allocate_slot)は範囲内の空きしか返さないが、--slot はそこを通らないので
# 範囲外・他タスクとの重複をここで弾く(重複を許すと2タスクが同じポートで衝突する)。
validate_slot() {
  local s="$1" task="$2" f other
  case "$s" in
    '' | *[!0-9]*)
      echo "taskenv: --slot には整数を指定してください: $s" >&2; return 1 ;;
  esac
  if [ "$s" -lt 1 ] || [ "$s" -gt "$port_slots" ]; then
    echo "taskenv: --slot は 1〜$port_slots で指定してください($(basename "$tasksets") の ports.slots): $s" >&2
    return 1
  fi
  for f in "$project"/__tasks/*/mise.toml; do
    [ -f "$f" ] || continue
    other="$(basename "$(dirname "$f")")"
    [ "$other" = "$task" ] && continue # 自タスクの割り当て直しは許す
    if [ "$(slot_in_file "$f")" = "$s" ]; then
      echo "taskenv: slot $s は既に $other が使っています(taskenv --ports で確認)" >&2
      return 1
    fi
  done
}

# 空いている最小のスロット番号を払い出す(既に割り当て済みならそれを再利用)
allocate_slot() {
  local task="$1" f s n hit
  s="$(slot_in_file "$project/__tasks/$task/mise.toml")"
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }

  local -a taken=()
  for f in "$project"/__tasks/*/mise.toml; do
    [ -f "$f" ] || continue
    s="$(slot_in_file "$f")"
    [ -n "$s" ] && taken+=("$s")
  done
  for ((n = 1; n <= port_slots; n++)); do
    hit=0
    for s in ${taken[@]+"${taken[@]}"}; do [ "$s" = "$n" ] && { hit=1; break; }; done
    [ "$hit" -eq 0 ] && { printf '%s' "$n"; return 0; }
  done
  echo "taskenv: 空きポートスロットがありません(ports.slots=$port_slots)。不要なタスクを taskenv --rm で撤去するか、.tasksets.yaml の slots を増やしてください" >&2
  return 1
}

# <project>/__tasks/<task>/mise.toml を生成する。
# mise は親ディレクトリの設定も読むので、この1ファイルで配下の全リポにポートが行き渡る。
write_task_env() {
  # local は「名前の宣言が先、代入が後」なので、同じ local 文の中で直前の変数を
  # 参照すると set -u で落ちる。taskdir は分けて代入する
  local task="$1" slot="$2" f name base k v
  local taskdir="$project/__tasks/$task"
  mkdir -p "$taskdir"
  f="$taskdir/mise.toml"
  {
    echo "# taskenv が生成。手で編集しないこと(taskenv --rm \"$task\" で消える)。"
    echo "# 各リポの mise.local.toml がここの ANDL_PORT_* を読んでポートを切り替える。"
    echo "# ポート定義は $(basename "$project")/.tasksets.yaml の ports セクション。"
    echo
    echo "[env]"
    printf 'ANDL_TASK = "%s"\n' "$task"
    printf 'ANDL_TASK_SLOT = "%s"\n' "$slot"
    while read -r name base; do
      [ -n "$name" ] || continue
      printf 'ANDL_PORT_%s = "%s"\n' "$(port_var_suffix "$name")" "$((base + slot * port_stride))"
    done < <(yq -r '.ports.services // {} | to_entries | .[] | .key + " " + (.value|tostring)' "$tasksets")
    # スロット固有の値(空文字は「スロット用の上書きなし」として書き出さない)
    while IFS='=' read -r k v; do
      [ -n "$k" ] && [ -n "$v" ] || continue
      printf '%s = "%s"\n' "$k" "$v"
    done < <(yq -r ".\"slot-extras\".\"$slot\" // {} | to_entries | .[] | .key + \"=\" + (.value|tostring)" "$tasksets")
  } > "$f"
  mise trust "$f" >/dev/null 2>&1 || true
}

# タスクのポート割り当てを表示する
show_task_ports() {
  local task="$1" f="$project/__tasks/$1/mise.toml" slot
  [ -f "$f" ] || { echo "$task: ポート未割り当て(mise.toml がありません)"; return 0; }
  slot="$(slot_in_file "$f")"
  echo "$task (slot ${slot:-?})"
  grep -E '^(ANDL_PORT_|ANDL_LINE_)' "$f" | sed 's/^/  /'
}

# ---- --ports: 割り当て状況の表示 --------------------------------------------

if [ "${1:-}" = "--ports" ]; then
  if [ $# -ge 2 ]; then
    show_task_ports "$2"
  else
    found=0
    for f in "$project"/__tasks/*/mise.toml; do
      [ -f "$f" ] || continue
      found=1
      show_task_ports "$(basename "$(dirname "$f")")"
    done
    [ "$found" -eq 1 ] || echo "ポート割り当て済みのタスクはありません"
  fi
  exit 0
fi

# ---- --assign: 既存タスクにポートだけ後付けする(worktree は触らない) ---------
# taskenv 導入前に作ったタスクや、mise.toml を消してしまったタスクの復旧用。
# 付与後は各リポで mise がポートを読み直すので、起動中のサーバーは再起動が必要。

if [ "${1:-}" = "--assign" ]; then
  [ $# -ge 2 ] || usage
  task="$2"
  [ -d "$project/__tasks/$task" ] || { echo "taskenv: タスクディレクトリがありません: $project/__tasks/$task" >&2; exit 1; }
  has_ports || { echo "taskenv: .tasksets.yaml に ports.services がありません" >&2; exit 1; }
  if [ -n "$slot_override" ]; then
    validate_slot "$slot_override" "$task" || exit 1
    slot="$slot_override"
  else
    slot="$(allocate_slot "$task")"
  fi
  write_task_env "$task" "$slot"
  show_task_ports "$task"
  exit 0
fi

# ---- --rm: タスクの worktree を全リポから撤去して片付ける --------------------

if [ "${1:-}" = "--rm" ]; then
  [ $# -ge 2 ] || usage
  task="$2"
  taskdir="$project/__tasks/$task"
  [ -d "$taskdir" ] || { echo "taskenv: タスクディレクトリがありません: $taskdir" >&2; exit 1; }
  found=0
  for d in "$taskdir"/*/; do
    [ -d "$d" ] || continue
    [ -e "$d/.git" ] || continue          # git worktree でないもの(.claude/.serena 等)はスキップ
    r="$(basename "$d")"
    found=1
    echo "==> removing $(basename "$project")/$r : $task"
    wt -C "$project/$r" remove "$task" --yes 2>&1 | grep -v 'Cannot change directory' || true
  done
  [ "$found" -eq 1 ] || echo "taskenv: $taskdir 配下に worktree がありません" >&2

  # worktree が全て撤去できていれば、生成物ごと task dir を撤去する。
  # 親dirで claude/serena を起動すると .claude/.serena 等が残り rmdir では消えないため、rm -rf で掃除する。
  # (未撤去の worktree が残っている場合は、作業ロスト防止のため rm せず警告する)
  leftover=""
  for d in "$taskdir"/*/; do
    [ -d "$d" ] || continue
    [ -e "$d/.git" ] && leftover="$leftover $(basename "$d")"
  done
  if [ -n "$leftover" ]; then
    echo "taskenv: worktree が未撤去のため $taskdir を残しました:$leftover" >&2
    echo "taskenv: 各リポの変更を確認のうえ手動で撤去してください" >&2
  else
    rm -rf "$taskdir"   # ポートスロット(mise.toml 台帳)も含め生成物ごと撤去=スロット解放
    echo "removed: $taskdir"
  fi
  exit 0
fi

# ---- 対象リポジトリの解決 ----------------------------------------------------

repos=()
if [ "${1:-}" = "--repos" ]; then
  [ $# -ge 3 ] || usage
  IFS=',' read -ra repos <<< "$2"
  task="$3"
else
  [ $# -ge 2 ] || usage
  set_name="$1"; task="$2"
  while IFS= read -r r; do
    [ -n "$r" ] && repos+=("$r")
  done < <(yq -r ".sets.\"$set_name\"[]?" "$tasksets")
fi
[ "${#repos[@]}" -gt 0 ] || { echo "taskenv: リポジトリセットが空です($tasksets を確認)" >&2; exit 1; }

# ---- --prompt 対話入力($EDITOR で複数行。worktree 作成前に受け取る) ----------
if [ "$prompt_mode" = "interactive" ]; then
  pf_edit="$(mktemp)"
  if [ -e /dev/tty ]; then
    "${EDITOR:-vi}" "$pf_edit" </dev/tty >/dev/tty 2>&1 || true
  else
    echo "taskenv: プロンプトを入力し、Ctrl-D で確定してください:" >&2
    cat > "$pf_edit" || true
  fi
  prompt_val="$(cat "$pf_edit")"
  rm -f "$pf_edit"
fi

# ---- ポートスロットの払い出し(worktree 作成より先) --------------------------
# pre-start フックのコード生成(graphql-codegen 等)が既にポート依存の環境変数を参照するため、
# wt switch の前にタスクルートの mise.toml を置いておく必要がある。
if has_ports; then
  if [ -n "$slot_override" ]; then
    validate_slot "$slot_override" "$task" || exit 1
    slot="$slot_override"
  else
    slot="$(allocate_slot "$task")"
  fi
  write_task_env "$task" "$slot"
  echo "==> port slot $slot"
  show_task_ports "$task" | tail -n +2
fi

# origin の default branch(なければ origin/main → origin/master)を返す
resolve_base() {
  local repo="$1" base=""
  base="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -z "$base" ]; then
    local cand
    for cand in origin/main origin/master; do
      git -C "$repo" rev-parse --verify --quiet "$cand" >/dev/null 2>&1 && { base="$cand"; break; }
    done
  fi
  printf '%s' "$base"
}

# 各リポで worktree を作成(worktrunk が <project>/__tasks/<task>/<repo> に配置)
# 派生元: --base 指定があればそれ、無ければ fetch 後に origin の default branch(= origin/main)
for r in "${repos[@]}"; do
  repo="$project/$r"
  echo "==> $(basename "$project")/$r : $task"

  base_args=()
  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    git -C "$repo" fetch --quiet origin || echo "  (fetch 失敗: オフライン? そのまま続行)" >&2
  fi
  if [ -n "$base_override" ]; then
    base="$base_override"
  else
    base="$(resolve_base "$repo")"
  fi
  [ -n "$base" ] && base_args=(--base "$base")

  if ! out=$(wt -C "$repo" switch --create "$task" ${base_args[@]+"${base_args[@]}"} --yes 2>&1); then
    echo "$out" >&2
    echo "taskenv: $r の worktree 作成に失敗しました" >&2
    exit 1
  fi
  # シェル統合非活性時の cosmetic な警告だけ落として表示
  echo "$out" | grep -v 'Cannot change directory' || true
done

taskdir="$project/__tasks/$task"
echo "ready: $taskdir"
has_ports && show_task_ports "$task"

# タスクディレクトリを tmux 新規ウィンドウで開き、左右2ペインに分割。左ペインで claude を起動
if [ -n "${TMUX:-}" ]; then
  left=$(tmux new-window -P -F '#{pane_id}' -c "$taskdir" -n "$task")
  tmux split-window -h -t "$left" -c "$taskdir"   # 縦仕切り(左|右)。右ペインはシェル
  if [ -n "$prompt_val" ]; then
    # プロンプトはファイル経由で claude に渡す(改行・引用符を安全に。$(cat) が読み終えたら rm)
    pf="$taskdir/.taskenv-prompt"
    printf '%s' "$prompt_val" > "$pf"
    tmux send-keys -t "$left" "claude \"\$(cat '$pf'; rm -f '$pf')\"" Enter
  else
    tmux send-keys -t "$left" 'claude' Enter          # 左ペインで claude 起動
  fi
  tmux select-pane -t "$left"
else
  echo "taskenv: tmux セッション外のため new-window はスキップしました($taskdir を手動で開いてください)" >&2
fi
